# OM Polyplast Environment Variables
# Copy this to .env and fill in real values

# Payload
PAYLOAD_SECRET=om-polyplast-dev-secret-change-in-production
DATABASE_URI=file:./db/payload.db
# DATABASE_AUTH_TOKEN is required when using Turso cloud LibSQL/SQLite
# DATABASE_AUTH_TOKEN=your-turso-auth-token
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend (email notifications)
RESEND_API_KEY=re_test_xxxxxxxxxxxx
ADMIN_EMAIL=admin@ompolyplast.com

# WhatsApp (wa.me deep link — no API needed for buyer-facing)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Site
NEXT_PUBLIC_SITE_NAME=OM Polyplast
NEXT_PUBLIC_SITE_URL=http://localhost:3000
